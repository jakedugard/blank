{
  "name": "blank",
  "version": "0.3.0",
  "description": "A blank window for capturing web work",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64",
    "install-app": "npm run pack && rm -rf /Applications/blank.app && cp -R dist/mac-arm64/blank.app /Applications/blank.app",
    "release": "APPLE_KEYCHAIN_PROFILE=blank electron-builder --mac --universal --publish never && V=$(node -p \"require('./package.json').version\") && gh release create v$V dist/blank-$V-universal.dmg dist/blank-$V-universal-mac.zip dist/blank-$V-universal-mac.zip.blockmap dist/latest-mac.yml --title \"blank $V\" --generate-notes"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "blank",
  "author": "Jake Dugard",
  "build": {
    "appId": "com.jakedugard.blank",
    "productName": "blank",
    "copyright": "Jake Dugard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "src/**",
      "ui/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": true,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "blank",
      "contents": [
        {
          "x": 130,
          "y": 150
        },
        {
          "x": 390,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "jakedugard",
      "repo": "blank",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
